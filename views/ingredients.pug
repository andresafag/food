html(lang="en")
  head
    title= "Random Recipe"
    link(rel="stylesheet", href="./styles.css", type="text/css")
    link(rel='preconnect' href='https://fonts.googleapis.com')
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(href='https://fonts.googleapis.com/css2?family=Fredericka+the+Great&family=Fugaz+One&family=Grape+Nuts&family=Pangolin&display=swap' rel='stylesheet')
    script(src='https://kit.fontawesome.com/adf65eea78.js' crossorigin='anonymous')
  body  
    nav
      include components/nav.pug
    section(id="submit_section")
      div(id="form-section")
        div
          form
            div(id="send-info")
              div(class="food-title")
                h2 Search recipes by ingredients
              // human-language ingredients input
              input(type="text", id="ingredientsInput", name="ingredients", placeholder="e.g. apples, flour, sugar")
              span.tooltiptext
              // change to button to avoid form navigation and keep input visible
              input(type="button", id="submit", value="Get awesome recipes")
              i.fa-solid.fa-dice
              span.tooltiptext
      article 
        div(id="contentForFood")
    include components/footer
script(src="./hamburgerMenu.js")
script(src="./ai.js")
script.
  const apiKey = !{JSON.stringify(apiKey || '')};
  const ingredientsInput = document.querySelector('#ingredientsInput'),
          contentForFood = document.querySelector('#contentForFood'),
          searchBtn = document.querySelector('#submit'),
          tooltipText = document.querySelector('.tooltiptext');
        const url = 
        searchBtn.addEventListener('click', fetchRecipes);

        async function fetchRecipes(){
          const raw = encodeURIComponent(ingredientsInput.value.replace(/\s*,\s*/g, ', '));
          console.log('Encoded ingredients input:', raw);
          fetch(`https://api.spoonacular.com/recipes/findByIngredients?ingredients=${raw}&number=4&apiKey=${apiKey}`)
          .then(response => response.json())
          .then(data => {
            console.log('Received data from Spoonacular API:', data);
            if (data.length === 0) {
              contentForFood.className = 'ai-output';
              contentForFood.innerHTML = `
                <div class="ai-output-header">No recipes found</div>
                <p class="ai-output-tail">Try a different mix of ingredients or add a few pantry staples.</p>
              `;
              return;
            }

            contentForFood.className = 'ai-output';
            contentForFood.innerHTML = '<div class="ai-output-header">Recipes you can make</div>';

            const recipeList = document.createElement('div');
            recipeList.className = 'ai-recipe-list';

            data.forEach(recipe => {
              const recipeDiv = document.createElement('div');
              recipeDiv.classList.add('ai-recipe-card');
              recipeDiv.innerHTML = `
                <img class="ai-recipe-img" src="${recipe.image}" alt="${recipe.title}">
                <div class="ai-recipe-text">
                  <h3>${recipe.title}</h3>
                  <p><strong>Used ingredients:</strong> ${recipe.usedIngredients && recipe.usedIngredients.length ? recipe.usedIngredients.map(ing => ing.name).join(', ') : 'None'}</p>
                  <p><strong>Missed ingredients:</strong> ${recipe.missedIngredients && recipe.missedIngredients.length ? recipe.missedIngredients.map(ing => ing.name).join(', ') : 'None'}</p>
                </div>
              `;
              recipeList.appendChild(recipeDiv);
            });

            contentForFood.appendChild(recipeList);
          })
          .catch(error => {
            console.error('Error fetching recipes:', error);
            contentForFood.className = 'ai-output';
            contentForFood.innerHTML = `
              <div class="ai-output-header">Something went wrong</div>
              <p class="ai-output-tail">Error fetching recipes. Please try again later.</p>
            `;
          });
        }


