html(lang="en")
  head
    title= "Random Recipe"
    link(rel="stylesheet", href="./styles.css", type="text/css")
    link(rel='preconnect' href='https://fonts.googleapis.com')
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(href='https://fonts.googleapis.com/css2?family=Fredericka+the+Great&family=Fugaz+One&family=Grape+Nuts&family=Pangolin&display=swap' rel='stylesheet')
    script(src='https://kit.fontawesome.com/adf65eea78.js' crossorigin='anonymous')
  body  
    nav
      include components/nav.pug
    section(id="submit_section")
      div(id="form-section")
        div
          form
            div(id="send-info")
              div(class="food-title")
                h2 Search recipes by ingredients
              // human-language ingredients input
              input(type="text", id="ingredientsInput", name="ingredients", placeholder="e.g. apples, flour, sugar")
              span.tooltiptext
              // change to button to avoid form navigation and keep input visible
              input(type="button", id="submit", value="Get awesome recipes")
              i.fa-solid.fa-dice
              span.tooltiptext
      article 
        div(id="contentForFood")
    include components/footer
script(src="./hamburgerMenu.js")
script(src="./spoonacular.js")
script.
  const questionIcons = [
    './images/question-icons/diet.png',
    './images/question-icons/ramen.png',
    './images/question-icons/biryani.png',
    './images/question-icons/dish.png',
    './images/question-icons/christmas-dinner.png'
  ];

  function randomQuestionIcon() {
    return questionIcons[Math.floor(Math.random() * questionIcons.length)];
  }

  const ingredientsInput = document.querySelector('#ingredientsInput'),
        contentForFood = document.querySelector('#contentForFood'),
        searchBtn = document.querySelector('#submit'),
        tooltipText = document.querySelector('.tooltiptext');

  searchBtn.addEventListener('click', fetchRecipes);

  // Listener para abrir/cerrar la burbuja
  contentForFood.addEventListener('click', function(e){
    const btn = e.target.closest('.note-btn');
    if(btn){
      const card = btn.closest('.ai-recipe-card');
      const bubble = card.querySelector('.speech-bubble');
      bubble.classList.toggle('active');
      
      if (bubble.classList.contains('active')) {
        const textarea = bubble.querySelector('textarea');
        if (textarea) textarea.focus();
      }
    }
  });

  // Listener para capturar el Enter en la burbuja
  contentForFood.addEventListener('keydown', async function(e){
    if (e.target.matches('.speech-bubble textarea') && e.key === 'Enter') {
      if (!e.shiftKey) {
        e.preventDefault();
        let question = e.srcElement.nextSibling.parentNode.parentElement.innerText + e.target.value;
          try {
              const response = await fetch('/ai-route', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({ noteText: question })
              });

              // fetch no arroja error en estados 400 o 500, hay que validar response.ok
              if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
              }

              const data = await response.json(); // En fetch nativo debes desempaquetar el JSON
              console.log('Server response:', data);
              e.target.value = ''; 
              e.target.value = data.result.analysis

            } catch (error) {
              console.error('Error sending note to server:', error);
            }
      }
    }
  });

  async function fetchRecipes(){
    const ingredients = ingredientsInput.value.replace(/\s*,\s*/g, ', ').trim();
    console.log('Ingredients input:', ingredients);

    try {
      const data = await spoonacularFetch('/recipes/findByIngredients', {
        ingredients,
        number: 4,
      });

      console.log('Received data from Spoonacular API:', data);
      if (data.length === 0) {
        contentForFood.className = 'ai-output';
        contentForFood.innerHTML = `
          <div class="ai-output-header">No recipes found</div>
          <p class="ai-output-tail">Try a different mix of ingredients or add a few pantry staples.</p>
        `;
        return;
      }

      contentForFood.className = 'ai-output';
      contentForFood.innerHTML = '<div class="ai-output-header">Recipes you can make</div>';

      const recipeList = document.createElement('div');
      recipeList.className = 'ai-recipe-list';

      data.forEach(recipe => {
        const recipeDiv = document.createElement('div');
        recipeDiv.classList.add('ai-recipe-card');
        recipeDiv.setAttribute('data-id', recipe.id);
        
        recipeDiv.innerHTML = `
          <button type="button" class="note-btn" title="Add note"><img src="${randomQuestionIcon()}" alt="Add note" /></button>
          <div class="speech-bubble">
            <textarea placeholder="Write a note for this meal..."></textarea>
          </div>
          <img class="ai-recipe-img" src="${recipe.image}" alt="${recipe.title}">
          <div class="ai-recipe-text">
            <h3>${recipe.title}</h3>
            <p><strong>Used ingredients:</strong> ${recipe.usedIngredients && recipe.usedIngredients.length ? recipe.usedIngredients.map(ing => ing.name).join(', ') : 'None'}</p>
            <p><strong>Missed ingredients:</strong> ${recipe.missedIngredients && recipe.missedIngredients.length ? recipe.missedIngredients.map(ing => ing.name).join(', ') : 'None'}</p>
          </div>
        `;
        recipeList.appendChild(recipeDiv);
      });

      contentForFood.appendChild(recipeList);
    } catch(error) {
      console.error('Error fetching recipes:', error);
      contentForFood.className = 'ai-output';
      contentForFood.innerHTML = `
        <div class="ai-output-header">Something went wrong</div>
        <p class="ai-output-tail">Error fetching recipes. Please try again later.</p>
      `;
    }
  }


