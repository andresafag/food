              }
            },
            {
              "httpApi": {
                "path": "/{proxy+}",
                "method": "any"
              }
            },
            {
              "schedule": {
                "rate": [
                  "rate(2 minutes)"
                ],
                "enabled": true,
                "input": {
                  "source": "aws.events",
                  "detail-type": "Scheduled Event",
                  "action": "warmup"
                }
              }
            }
          ],
          "name": "express-pug-app-dev-api"
        }
      },
      "resources": {
        "Resources": {
          "ApiLogGroup": {
            "Type": "AWS::Logs::LogGroup",
            "Properties": {
              "RetentionInDays": 7
            },
            "DeletionPolicy": "Retain"
          }
        }
      },
      "package": {
        "individually": true,
        "patterns": [
          "../views/**",
          "../public/**"
        ],
        "artifactsS3KeyDirname": "serverless/express-pug-app/dev/code-artifacts"
